{
  "name": "copper-yard-fps",
  "version": "1.0.0",
  "private": true,
  "description": "铜港货场 · Copper Yard — 离线网页版短局战术 FPS",
  "scripts": {
    "build": "python build.py",
    "serve": "python -m http.server 8080 --bind 127.0.0.1",
    "test": "node --test qa/*.test.cjs",
    "test:browser": "node qa/tactical-mission.verify.cjs",
    "test:fullscreen": "node qa/fullscreen.verify.cjs",
    "test:audio": "node qa/selected-audio.verify.cjs",
    "test:inspect": "node qa/inspect.verify.cjs",
    "test:backstab": "node qa/backstab.verify.cjs",
    "test:melee-selection": "node qa/melee-selection.verify.cjs",
    "test:butterfly-draw": "node qa/butterfly-draw.verify.cjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "playwright": "1.62.1"
  }
}
